# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Exports (produced by tools/export_web.sh). build/.gdignore IS committed — it stops Godot
# from importing previous builds into the next one.
build/*
!build/.gdignore

# macOS
.DS_Store

# Editor-local settings
.vscode/
